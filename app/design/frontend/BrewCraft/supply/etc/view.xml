<?xml version="1.0"?>

<view xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Config/etc/view.xsd">

    <media>

        <images module="Magento_Catalog">

            <!-- PDP -->
            <image id="product_page_image_medium" type="image">

                <width>700</width>
                <height>700</height>

                <constrain>false</constrain>
                <aspect_ratio>true</aspect_ratio>
                <frame>false</frame>
                <transparency>true</transparency>

            </image>

            <image id="product_page_image_large" type="image">

                <width>1200</width>
                <height>1200</height>

                <constrain>false</constrain>
                <aspect_ratio>true</aspect_ratio>
                <frame>false</frame>
                <transparency>true</transparency>

            </image>


            <!-- Related products -->
            <image id="related_products_list" type="small_image">

                <width>320</width>
                <height>320</height>

                <constrain>false</constrain>
                <aspect_ratio>true</aspect_ratio>
                <frame>false</frame>
                <transparency>true</transparency>

            </image>

        </images>

    </media>

    <vars module="Magento_Catalog">

        <var name="gallery">

            <var name="nav">thumbs</var>

            <var name="navdir">vertical</var>

            <var name="navarrows">true</var>

            <var name="arrows">true</var>

            <var name="loop">true</var>

            <var name="keyboard">true</var>

            <var name="caption">false</var>

            <var name="allowfullscreen">true</var>

            <var name="navtype">slides</var>

            <var name="thumbwidth">72</var>

            <var name="thumbheight">82</var>

            <var name="thumbmargin">10</var>

            <var name="thumbborderwidth">1</var>

            <var name="transition">

                <var name="effect">slide</var>

                <var name="duration">350</var>

            </var>

            <var name="fullscreen">

                <var name="nav">thumbs</var>

                <var name="navdir">horizontal</var>

                <var name="loop">true</var>

                <var name="arrows">true</var>

                <var name="caption">false</var>

                <var name="navtype">slides</var>

            </var>

        </var>

    </vars>

</view>
