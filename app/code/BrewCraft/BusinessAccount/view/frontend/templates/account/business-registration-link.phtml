<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/**
 * @var Template $block
 * @var Escaper $escaper
 */

$contextType = (string)$block->getData('context_type');
$isLoginPage = $contextType === 'login';

$businessRegistrationUrl = $block->getUrl(
    'businessaccount/account/create'
);

$customerLoginUrl = $block->getUrl(
    'customer/account/login'
);
?>

<section class="brewcraft-business-registration-cta">

    <div class="brewcraft-business-registration-cta__content">

        <span class="brewcraft-business-registration-cta__eyebrow">
            <?= $escaper->escapeHtml(
                __('BrewCraft Business')
            ) ?>
        </span>

        <h2 class="brewcraft-business-registration-cta__title">

            <?php if ($isLoginPage): ?>

                <?= $escaper->escapeHtml(
                    __('Looking for a Business Account?')
                ) ?>

            <?php else: ?>

                <?= $escaper->escapeHtml(
                    __('Registering for Your Business?')
                ) ?>

            <?php endif; ?>

        </h2>

        <p class="brewcraft-business-registration-cta__description">

            <?php if ($isLoginPage): ?>

                <?= $escaper->escapeHtml(
                    __(
                        'Sign in with your existing customer account or submit a new business application to access BrewCraft business services.'
                    )
                ) ?>

            <?php else: ?>

                <?= $escaper->escapeHtml(
                    __(
                        'Apply for a BrewCraft Business Account to access wholesale pricing, quotation services and other business benefits after approval.'
                    )
                ) ?>

            <?php endif; ?>

        </p>

        <div class="brewcraft-business-registration-cta__benefits">

            <div class="brewcraft-business-registration-cta__benefit">

                <strong>
                    <?= $escaper->escapeHtml(
                        __('Wholesale Access')
                    ) ?>
                </strong>

                <span>
                    <?= $escaper->escapeHtml(
                        __('Business pricing after approval')
                    ) ?>
                </span>

            </div>

            <div class="brewcraft-business-registration-cta__benefit">

                <strong>
                    <?= $escaper->escapeHtml(
                        __('Request Quotes')
                    ) ?>
                </strong>

                <span>
                    <?= $escaper->escapeHtml(
                        __('Request pricing for larger orders')
                    ) ?>
                </span>

            </div>

            <div class="brewcraft-business-registration-cta__benefit">

                <strong>
                    <?= $escaper->escapeHtml(
                        __('Business Support')
                    ) ?>
                </strong>

                <span>
                    <?= $escaper->escapeHtml(
                        __('Dedicated services for approved accounts')
                    ) ?>
                </span>

            </div>

        </div>

        <div class="actions-toolbar">

