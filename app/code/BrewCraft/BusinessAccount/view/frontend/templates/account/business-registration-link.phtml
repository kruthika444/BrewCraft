<?php

declare(strict_types=1);

use BrewCraft\BusinessAccount\Block\Account\BusinessRegistrationLink;
use Magento\Framework\Escaper;

/**
 * @var BusinessRegistrationLink $block
 * @var Escaper $escaper
 */
?>

<section class="brewcraft-business-registration-cta">

    <div class="brewcraft-business-registration-cta__content">

        <span class="brewcraft-business-registration-cta__eyebrow">
            <?= $escaper->escapeHtml(__('BrewCraft Business')) ?>
        </span>

        <h2 class="brewcraft-business-registration-cta__title">
            <?= $escaper->escapeHtml($block->getHeading()) ?>
        </h2>

        <p class="brewcraft-business-registration-cta__description">
            <?= $escaper->escapeHtml($block->getDescription()) ?>
        </p>

        <?php if ($block->shouldShowBenefits()): ?>

            <div class="brewcraft-business-registration-cta__benefits">

                <div class="brewcraft-business-registration-cta__benefit">
                    <strong>
                        <?= $escaper->escapeHtml(__('Wholesale Access')) ?>
                    </strong>

                    <span>
                        <?= $escaper->escapeHtml(
                            __('Business pricing after approval')
                        ) ?>
                    </span>
                </div>

                <div class="brewcraft-business-registration-cta__benefit">
                    <strong>
                        <?= $escaper->escapeHtml(__('Request Quotes')) ?>
                    </strong>

                    <span>
                        <?= $escaper->escapeHtml(
                            __('Request pricing for larger orders')
                        ) ?>
                    </span>
                </div>

                <div class="brewcraft-business-registration-cta__benefit">
                    <strong>
                        <?= $escaper->escapeHtml(__('Business Support')) ?>
                    </strong>

                    <span>
                        <?= $escaper->escapeHtml(
                            __('Dedicated services for approved accounts')
                        ) ?>
                    </span>
                </div>

            </div>

        <?php endif; ?>

        <div class="actions-toolbar">

            <div class="primary">

                <a class="action primary"
                   href="<?= $escaper->escapeUrl(
                       $block->getActionUrl()
                   ) ?>">

                    <span>
                        <?= $escaper->escapeHtml(
                            $block->getActionLabel()
                        ) ?>
                    </span>

                </a>

            </div>

            <?php if (
                !$block->isLoginPage()
                && !$block->isCustomerLoggedIn()
            ): ?>

                <div class="secondary">

                    <a class="action secondary"
                       href="<?= $escaper->escapeUrl(
                           $block->getCustomerLoginUrl()
                       ) ?>">

                        <span>
                            <?= $escaper->escapeHtml(
                                __('Already Have an Account? Sign In')
                            ) ?>
                        </span>

                    </a>

                </div>

            <?php endif; ?>

        </div>

        <?php if (!$block->hasBusinessApplication()): ?>

            <p class="brewcraft-business-registration-cta__note">
                <?= $escaper->escapeHtml(
                    __(
                        'Business applications are reviewed before business benefits are activated.'
                    )
                ) ?>
            </p>

        <?php elseif ($block->isRejected()): ?>

            <p class="brewcraft-business-registration-cta__note">
                <?= $escaper->escapeHtml(
                    __(
                        'Rejected applications cannot currently be resubmitted online. Contact BrewCraft support if your business information has changed.'
                    )
                ) ?>
            </p>

        <?php endif; ?>

    </div>

</section>
