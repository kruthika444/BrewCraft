<?xml version="1.0"?>

<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">

    <policies>

        <policy id="script-src">
            <values>
                <value id="razorpay_checkout"
                       type="host">https://checkout.razorpay.com</value>
            </values>
        </policy>

        <policy id="frame-src">
            <values>
                <value id="razorpay_frame"
                       type="host">https://api.razorpay.com</value>

                <value id="razorpay_checkout_frame"
                       type="host">https://checkout.razorpay.com</value>
            </values>
        </policy>

        <policy id="connect-src">
            <values>
                <value id="razorpay_api"
                       type="host">https://api.razorpay.com</value>

                <value id="razorpay_checkout_connect"
                       type="host">https://checkout.razorpay.com</value>
            </values>
        </policy>

    </policies>

</csp_whitelist>
