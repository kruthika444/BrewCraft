<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">

    <system>

        <section id="payment">

            <group id="brewcraft_razorpay" translate="label" type="text" sortOrder="950" showInDefault="1" showInWebsite="1" showInStore="1">

                <label>BrewCraft Razorpay</label>

                <field id="active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">

                    <label>Enabled</label>

                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>

                </field>

                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">

                    <label>Title</label>

                    <comment>
                        Payment method title shown to customers during checkout.
                    </comment>

                </field>

                <field id="test_mode" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">

                    <label>Test Mode</label>

                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>

                    <comment>
                        Enable this while using Razorpay test credentials.
                    </comment>

                </field>

                <field id="key_id" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">

                    <label>Key ID</label>

                    <comment>
                        Razorpay Test Key ID usually starts with rzp_test_.
                    </comment>

                </field>

                <field id="key_secret" translate="label" type="obscure" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">

                    <label>Key Secret</label>

                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>

                    <comment>
                        Keep this secret. It must never be exposed to frontend JavaScript.
                    </comment>

                </field>

                <field id="order_status" translate="label" type="select" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="0">

                    <label>New Order Status</label>

                    <source_model>Magento\Sales\Model\Config\Source\Order\Status\NewStatus</source_model>

                </field>

                <field id="debug" translate="label" type="select" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">

                    <label>Debug Logging</label>

                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>

                </field>

                <field id="webhook_secret" translate="label" type="obscure" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Webhook Secret</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Secret used to verify incoming Razorpay webhook requests.</comment>
                </field>

            </group>

        </section>

    </system>

</config>
