<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>

        <referenceBlock name="minicart">

            <arguments>

                <argument name="jsLayout"
                          xsi:type="array">

                    <item name="components"
                          xsi:type="array">

                        <item name="minicart_content"
                              xsi:type="array">

                            <item name="children"
                                  xsi:type="array">

                                <item name="brewcraft.quote.action"
                                      xsi:type="array">

                                    <item name="component"
                                          xsi:type="string">
                                        BrewCraft_RequestQuote/js/view/minicart-quote
                                    </item>

                                    <item name="config"
                                          xsi:type="array">

                                        <item name="displayArea"
                                              xsi:type="string">
                                            extraInfo
                                        </item>

                                        <item name="template"
                                              xsi:type="string">
                                            BrewCraft_RequestQuote/minicart/quote-action
                                        </item>

                                    </item>

                                </item>

                            </item>

                        </item>

                    </item>

                </argument>

            </arguments>

        </referenceBlock>

    </body>

</page>
