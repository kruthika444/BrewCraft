<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>

        <referenceContainer name="content">

            <block class="BrewCraft\RequestQuote\Block\Cart\AcceptedQuoteNotice"
                   name="brewcraft.accepted.quote.cart.notice"
                   template="BrewCraft_RequestQuote::cart/accepted-quote-notice.phtml"
                   before="-"
                   cacheable="false"/>

        </referenceContainer>


        <!-- Request Quote belongs directly inside the cart container -->
        <referenceContainer name="checkout.cart.container">

            <block class="BrewCraft\RequestQuote\Block\Cart\RequestQuote"
                   name="brewcraft.request.quote.cart.action"
                   template="BrewCraft_RequestQuote::cart/request-quote.phtml"
                   after="checkout.cart.form"
                   cacheable="false"/>

        </referenceContainer>

    </body>

</page>
