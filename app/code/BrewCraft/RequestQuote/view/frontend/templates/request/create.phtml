                    $quantity = (float)$cartItem->getQty();
                    $unitPrice = (float)$cartItem->getCalculationPrice();
                    $rowTotal = $unitPrice * $quantity;
                    ?>

                    <tr>
                        <td>
                            <?= $escaper->escapeHtml(
                                (string)$cartItem->getName()
                            ) ?>
                        </td>

                        <td>
                            <?= $escaper->escapeHtml(
                                (string)$cartItem->getSku()
                            ) ?>
                        </td>

                        <td>
                            <?= $escaper->escapeHtml(
                                $block->formatPrice($unitPrice)
                            ) ?>
                        </td>

                        <td>
                            <?= $escaper->escapeHtml(
                                (string)$quantity
                            ) ?>
                        </td>

                        <td>
                            <?= $escaper->escapeHtml(
                                $block->formatPrice($rowTotal)
                            ) ?>
                        </td>
                    </tr>

                <?php endforeach; ?>

                </tbody>

                <tfoot>
                <tr>
                    <th colspan="4"
                        scope="row">

                        <?= $escaper->escapeHtml(
                            __('Current Subtotal')
                        ) ?>

                    </th>

                    <td>
                        <strong>
                            <?= $escaper->escapeHtml(
                                $block->formatPrice(
                                    $block->getCartSubtotal()
                                )
