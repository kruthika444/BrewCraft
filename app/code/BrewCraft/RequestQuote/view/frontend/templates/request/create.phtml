                    </span>

                </label>

                <div class="control">

                    <textarea name="customer_message"
                              id="customer_message"
                              rows="6"
                              maxlength="5000"
                              placeholder="<?= $escaper->escapeHtmlAttr(
                                  __(
                                      'Tell us about your expected volume, delivery requirements or pricing request.'
                                  )
                              ) ?>"></textarea>

                </div>

            </div>

        </fieldset>

        <div class="actions-toolbar">

            <div class="primary">

                <button type="submit"
