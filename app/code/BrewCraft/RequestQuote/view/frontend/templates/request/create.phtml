                </span>
            </legend>

            <div class="field quote-name required">

                <label class="label"
                       for="quote_name">

                    <span>
                        <?= $escaper->escapeHtml(
                            __('Quote Name')
                        ) ?>
                    </span>

                </label>

                <div class="control">

                    <input type="text"
                           name="quote_name"
                           id="quote_name"
