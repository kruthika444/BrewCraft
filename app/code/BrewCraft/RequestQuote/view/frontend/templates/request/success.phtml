<?php

declare(strict_types=1);

use BrewCraft\RequestQuote\Block\Request\Success;
use Magento\Framework\Escaper;

/**
 * @var Success $block
 * @var Escaper $escaper
 */

$quoteRequest = $block->getQuoteRequest();
?>

<?php if ($quoteRequest): ?>

    <section class="brewcraft-request-quote-success">

        <div class="brewcraft-request-quote-success__icon"
             aria-hidden="true">
            ✓
        </div>

        <div class="brewcraft-request-quote-success__eyebrow">
            <?= $escaper->escapeHtml(
                __('BrewCraft Business')
            ) ?>
        </div>

        <h1 class="brewcraft-request-quote-success__title">
            <?= $escaper->escapeHtml(
                __('Quote Request Submitted')
            ) ?>
        </h1>

        <p class="brewcraft-request-quote-success__text">
            <?= $escaper->escapeHtml(
                __(
                    'Our business team will review your request and prepare a custom price proposal.'
                )
            ) ?>
