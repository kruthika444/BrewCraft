<?php

declare(strict_types=1);

use BrewCraft\RequestQuote\Block\Request\Success;
use Magento\Framework\Escaper;

/**
 * @var Success $block
 * @var Escaper $escaper
 */

$quoteRequest = $block->getQuoteRequest();
?>

<?php if ($quoteRequest): ?>

    <section class="brewcraft-request-quote-success">

        <span>
            <?= $escaper->escapeHtml(
                __('BrewCraft Business')
            ) ?>
        </span>

        <h1>
            <?= $escaper->escapeHtml(
                __('Your Quote Request Has Been Submitted')
            ) ?>
        </h1>

        <p>
            <?= $escaper->escapeHtml(
                __(
                    'Our business team will review your request and prepare a custom price proposal.'
                )
            ) ?>
        </p>

        <div class="brewcraft-request-quote-success__summary">

            <p>
                <strong>
                    <?= $escaper->escapeHtml(
                        __('Quote Number:')
                    ) ?>
                </strong>

                <?= $escaper->escapeHtml(
                    $quoteRequest->getQuoteNumber()
                ) ?>
            </p>

            <p>
                <strong>
                    <?= $escaper->escapeHtml(
                        __('Quote Name:')
