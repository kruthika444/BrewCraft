                   $block->getContinueShoppingUrl()
               ) ?>">

                <span>
                    <?= $escaper->escapeHtml(
                        __('Continue Shopping')
                    ) ?>
                </span>

            </a>

            <a class="action brewcraft-request-quote-success__secondary"
               href="<?= $escaper->escapeUrl(
                   method_exists($block, 'getMyQuotesUrl')
