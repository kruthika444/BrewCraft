        <div class="brewcraft-request-quote-success__summary">

            <div class="brewcraft-request-quote-success__row">
                <span>
                    <?= $escaper->escapeHtml(
                        __('Quote Number')
                    ) ?>
                </span>

                <strong>
                    <?= $escaper->escapeHtml(
                        $quoteRequest->getQuoteNumber()
                    ) ?>
                </strong>
            </div>

            <div class="brewcraft-request-quote-success__row">
                <span>
                    <?= $escaper->escapeHtml(
                        __('Quote Name')
                    ) ?>
