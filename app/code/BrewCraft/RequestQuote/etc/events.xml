<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <event name="sales_quote_collect_totals_before">
        <observer name="brewcraft_request_quote_reapply_negotiated_price"
                  instance="BrewCraft\RequestQuote\Observer\ReapplyNegotiatedPrice"/>
    </event>

    <event name="sales_model_service_quote_submit_success">
        <observer name="brewcraft_request_quote_mark_converted_after_order"
                  instance="BrewCraft\RequestQuote\Observer\MarkQuoteConvertedAfterOrder"/>
    </event>

</config>
